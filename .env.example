# Скопируйте в apps/server/.env и поменяйте значения.
# Обязательно в production: длинный случайный секрет (openssl rand -base64 48)
APP_SECRET=change-me-to-a-long-random-string-at-least-32-chars
NODE_ENV=development
HOST=127.0.0.1
PORT=4000
# Публичный адрес веб-клиента (используется для проверки Origin и в письмах).
# На Render можно не задавать — возьмётся RENDER_EXTERNAL_URL.
PUBLIC_ORIGIN=http://localhost:5173
# Количество доверенных прокси перед приложением (за Render/Caddy/Nginx — 1)
TRUST_PROXY=0
# Загрузить демо-данные при первом запуске (для публичного демо)
DEMO_SEED=false
# Где хранить базу данных и загруженные файлы
DATA_DIR=./data
# Максимальные размеры загрузок (в мегабайтах)
MAX_IMAGE_MB=15
MAX_VIDEO_MB=300
# Логирование: fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# ── Почта ─────────────────────────────────────────────────────────────────────
# Коды подтверждения при регистрации, вход по коду из письма (2FA), восстановление
# пароля, уведомления о входе. В разработке письма попадают в «Тестовую почту»
# на экране входа. В production задайте ОДИН из способов:
#   BREVO_API_KEY  — https://www.brevo.com (бесплатно 300 писем/день, работает по HTTPS)
#   RESEND_API_KEY — https://resend.com (нужен свой домен)
#   SMTP_URL       — smtps://логин:пароль@smtp.example.com:465 (на бесплатном Render SMTP закрыт)
# MAIL_FROM — от кого письма; адрес должен быть подтверждён у провайдера.
MAIL_FROM="SpaceUp <no-reply@example.com>"
# BREVO_API_KEY=xkeysib-...
# RESEND_API_KEY=re_...
# SMTP_URL=smtps://user:password@smtp.example.com:465

# ── Звонки (WebRTC) ───────────────────────────────────────────────────────────
# STUN помогает устройствам найти друг друга; по умолчанию — публичные серверы.
# Если звонки не соединяются в мобильных сетях или за строгим NAT, нужен TURN
# (например, свой coturn или облачный): адреса через запятую и учётные данные.
# STUN_URLS=stun:stun.l.google.com:19302,stun:stun.cloudflare.com:3478
# TURN_URLS=turns:turn.example.com:5349
# TURN_USERNAME=spaceup
# TURN_CREDENTIAL=секрет
# Проще — готовый TURN с временными учётными данными (берутся на сервере, клиенту ключ не виден):
# Cloudflare (бесплатно): Realtime → TURN Server → создать ключ
# CF_TURN_KEY_ID=
# CF_TURN_API_TOKEN=
# Metered: ссылка из панели вида https://<app>.metered.live/api/v1/turn/credentials?apiKey=…
# METERED_TURN_URL=
# Внешнее хранилище: копия базы (раз в минуту при изменениях и при остановке) и все
# загруженные файлы. Нужно там, где диск временный (бесплатный Render): при старте на
# чистом диске база восстанавливается, файлы скачиваются обратно при первом открытии.
# Любое S3-совместимое: Backblaze B2 (10 ГБ бесплатно, без карты), Cloudflare R2,
# Yandex Object Storage, AWS S3, MinIO. Бакет — приватный.
# S3_ENDPOINT=https://s3.eu-central-003.backblazeb2.com
# S3_BUCKET=spaceup-data
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_REGION=            # по умолчанию определяется по адресу
# S3_PREFIX=spaceup     # папка внутри бакета
# BACKUP_INTERVAL_SEC=60
