# Скопируйте в apps/server/.env и поменяйте значения.
# Обязательно в production: длинный случайный секрет (openssl rand -base64 48)
APP_SECRET=change-me-to-a-long-random-string-at-least-32-chars
NODE_ENV=development
HOST=127.0.0.1
PORT=4000
# Публичный адрес веб-клиента (используется для проверки Origin и в письмах).
# На Render можно не задавать — возьмётся RENDER_EXTERNAL_URL.
PUBLIC_ORIGIN=http://localhost:5173
# Количество доверенных прокси перед приложением (за Render/Caddy/Nginx — 1)
TRUST_PROXY=0
# Загрузить демо-данные при первом запуске (для публичного демо)
DEMO_SEED=false
# Где хранить базу данных и загруженные файлы
DATA_DIR=./data
# Максимальные размеры загрузок (в мегабайтах)
MAX_IMAGE_MB=15
MAX_VIDEO_MB=300
# Логирование: fatal | error | warn | info | debug | trace
LOG_LEVEL=info
