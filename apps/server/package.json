{
  "name": "@omni/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "API-сервер Omni: REST + WebSocket, SQLite, безопасность по умолчанию.",
  "scripts": {
    "dev": "tsx watch --clear-screen=false --disable-warning=ExperimentalWarning src/index.ts",
    "build": "node build.mjs",
    "start": "node --disable-warning=ExperimentalWarning dist/index.js",
    "seed": "tsx --disable-warning=ExperimentalWarning src/db/seed.ts",
    "migrate": "tsx --disable-warning=ExperimentalWarning src/db/migrate-cli.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/helmet": "^13.0.2",
    "@fastify/multipart": "^9.2.1",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^10.1.6",
    "@fastify/websocket": "^11.2.0",
    "@omni/shared": "0.1.0",
    "fastify": "^5.6.1",
    "nodemailer": "^10.1.2",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "@types/nodemailer": "^8.0.2",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.28.2",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3",
    "vitest": "^5.0.5"
  }
}
