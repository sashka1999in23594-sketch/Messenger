{
  "name": "sunnet-desktop",
  "productName": "Sunnet",
  "version": "1.1.0",
  "private": true,
  "description": "Sunnet для компьютера — приложение-обёртка над веб-версией мессенджера",
  "author": {
    "name": "Sunnet",
    "email": "spaceup.support@gmail.com"
  },
  "homepage": "https://omni-w0fb.onrender.com",
  "license": "UNLICENSED",
  "main": "src/main.js",
  "desktopName": "sunnet.desktop",
  "scripts": {
    "start": "electron .",
    "config": "node scripts/write-config.js",
    "dist": "node scripts/write-config.js && electron-builder --publish never"
  },
  "devDependencies": {
    "electron": "44.9.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "app.spaceup.desktop",
    "productName": "Sunnet",
    "copyright": "© Sunnet",
    "publish": null,
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "package.json",
      "src/**/*",
      "build/icons/256x256.png"
    ],
    "asar": true,
    "electronLanguages": [
      "ru",
      "en-US"
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "build/icon-mac.png",
      "category": "public.app-category.social-networking",
      "identity": "-",
      "hardenedRuntime": false,
      "darkModeSupport": true,
      "artifactName": "Sunnet-mac-${arch}.${ext}",
      "extendInfo": {
        "NSCameraUsageDescription": "Sunnet использует камеру для видеозвонков и видеосообщений.",
        "NSMicrophoneUsageDescription": "Sunnet использует микрофон для звонков и голосовых сообщений."
      }
    },
    "dmg": {
      "title": "Sunnet",
      "artifactName": "Sunnet-mac-${arch}.${ext}",
      "writeUpdateInfo": false
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "artifactName": "Sunnet-Setup.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Sunnet",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "differentialPackage": false,
      "artifactName": "Sunnet-Setup.${ext}"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icons",
      "executableName": "sunnet",
      "syncDesktopName": true,
      "category": "Network;InstantMessaging",
      "maintainer": "Sunnet <spaceup.support@gmail.com>",
      "vendor": "Sunnet",
      "synopsis": "Мессенджер Sunnet"
    },
    "appImage": {
      "artifactName": "Sunnet.${ext}"
    },
    "deb": {
      "packageName": "sunnet",
      "packageCategory": "net",
      "artifactName": "sunnet_amd64.${ext}"
    }
  }
}
